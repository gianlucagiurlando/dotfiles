{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "write": "allow",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "uv run *": "allow",
      "uv sync*": "allow",
      "uv lock*": "allow",
      "pytest*": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "cargo check*": "allow",
      "cargo test*": "allow",
      "cargo fmt*": "allow",
      "cargo clippy*": "allow",
      "go test*": "allow",
      "go vet*": "allow",
      "go fmt*": "allow",
      "rm *": "ask",
      "sudo *": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git push*": "ask",
      "git checkout -- *": "ask",
      "git restore*": "ask"
    }
  }
}
