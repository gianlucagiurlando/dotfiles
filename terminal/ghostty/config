# =======================================================
# Ghostty entry point — modular config
#
# Per Ghostty's docs, `config-file` includes are loaded AFTER this file
# and OVERRIDE any matching keys set here. To avoid surprising precedence,
# this file contains ONLY config-file lines — every actual setting lives
# in one of the included files below.
#
# Modules live alongside this file:
#   colors.ghostty       → theme (Catppuccin Mocha)
#   fonts.ghostty         → font family & size
#   keybindings.ghostty   → key bindings
#   cursor.ghostty        → cursor style & color
# =======================================================

config-file = "colors.ghostty"
config-file = "fonts.ghostty"
config-file = "keybindings.ghostty"
config-file = "cursor.ghostty"

# Per-machine overrides (e.g. a smaller font size on a smaller screen).
# Untracked — see ghostty/config.local.example. The "?" prefix makes this
# include optional, so machines without one are unaffected.
config-file = "?config.local"
